generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum ColumnId {
  TODO
  DOING
  TESTING
  DONE
}

enum Effort {
  SMALL
  MEDIUM
  LARGE
}

model Card {
  id          String    @id @default(cuid())
  title       String
  description String?
  column      ColumnId  @default(TODO)
  createdAt   DateTime  @default(now())
  dueDate     DateTime?
  effort      Effort
  owners      String
}
